# ==========================================
# 🏋️ LIFETIME FREE GYM MANAGEMENT SYSTEM (.env)
# ==========================================

# 1. Database (Neon Serverless PostgreSQL - 100% Free 500MB)
DATABASE_URL="postgresql://user:password@ep-xxxxxx-pooler.us-east-2.aws.neon.tech/gymdb?sslmode=require"

# 2. Better Auth (Self-hosted in Neon DB - 100% Free)
BETTER_AUTH_SECRET="your_secure_random_better_auth_secret_32_chars"
BETTER_AUTH_URL="http://localhost:3000"

# 3. Cloudflare R2 Object Storage (100% Free 10GB & Zero Egress)
# (Used for Member Photos, Aadhaar / ID Proofs, PDF Invoices)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="gym-documents"
R2_PUBLIC_URL="https://pub-xxxxxx.r2.dev"

# 4. Resend (Email Service - 100% Free 3,000 emails/month)
# (Used for Digital Invoices & Renewal Reminders)
RESEND_API_KEY="re_1234567890abcdef"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# 5. Upstash QStash (Serverless Daily Cron - 100% Free 500 req/day)
# (Triggers 8:00 AM Daily Expiry Checks for 7, 3, 1-Day Alerts)
QSTASH_CURRENT_SIGNING_KEY="your_qstash_signing_key"
QSTASH_NEXT_SIGNING_KEY="your_qstash_next_signing_key"
CRON_SECRET="your_internal_cron_secret"

# 6. WhatsApp Worker (Render Free Tier - Baileys Bot)
WHATSAPP_WORKER_URL="https://your-gym-worker.onrender.com"
WHATSAPP_API_SECRET="your_shared_secret_between_nextjs_and_worker"
